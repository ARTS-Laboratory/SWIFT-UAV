# SWIFT UAV - SITL session E (KCUB runway 13, out-and-back range test)
# Written by swift_sitl_cub_e v0.1, 2026-11-15 00:41
# Load after plane.parm and swift_sitl.param (batt and vtail files last).
# Best-range speed 22.5 m/s is commanded in the mission (DO_CHANGE_SPEED), not here.
# %    level-flight throttle at the 22.5 m/s best-range speed [EST] (swift_sitl.param had 56)
TRIM_THROTTLE,53
# m/s  climb-out rate, as Session D (swift_sitl.param had 1.1)
TECS_CLMB_MAX,2
# m/s  approach airspeed (= AIRSPEED_MIN)
TECS_LAND_ARSPD,22
# m/s  sink rate after the flare
TECS_LAND_SINK,0.6
# m    flare starts at this height ...
LAND_FLARE_ALT,3
# s    ... or this many seconds to touchdown
LAND_FLARE_SEC,2
# deg  nose-up target in the flare (tricycle gear)
LAND_PITCH_DEG,1
# s    disarm this long after touchdown
LAND_DISARMDELAY,20
# -    an RTL (incl. battery failsafe) jumps to the landing sequence
RTL_AUTOLAND,2
