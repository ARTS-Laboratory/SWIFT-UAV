# SWIFT UAV - SITL session D (KCUB runway 13, motor-validation flight)
# Written by swift_sitl_cub_d v0.1, 2026-11-11 23:24
# Load after plane.parm and swift_sitl.param (swift_sitl_batt.param last).
# Replaces TRIM_THROTTLE and TECS_CLMB_MAX from swift_sitl.param for this flight only.
# %    level-flight throttle at 23 m/s from the MAD X7215 table (swift_sitl.param had 56)
TRIM_THROTTLE,54
# m/s  allow the max-rate climb: the real motor has ~2.9 m/s spare at 23 m/s (swift_sitl.param had 1.1)
TECS_CLMB_MAX,2
# m/s  approach airspeed (= AIRSPEED_MIN)
TECS_LAND_ARSPD,22
# m/s  sink rate after the flare
TECS_LAND_SINK,0.6
# m    flare starts at this height ...
LAND_FLARE_ALT,3
# s    ... or this many seconds to touchdown
LAND_FLARE_SEC,2
# deg  nose-up target in the flare (tricycle gear)
LAND_PITCH_DEG,1
# s    disarm this long after touchdown
LAND_DISARMDELAY,20
# -    an RTL (incl. battery failsafe) jumps to the landing sequence
RTL_AUTOLAND,2
